                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="OpenHistoryHotkeyTextBox" Grid.Column="0" Header="Open History Window" IsReadOnly="True" PlaceholderText="Ctrl+Alt+H" KeyDown="ShortcutTextBox_KeyDown" />
                                <Button Grid.Column="1" MinWidth="80" Margin="0,28,0,0" Content="Record" Tag="OpenHistoryHotkeyTextBox" Click="ShortcutRecorderButton_Click" />
                            </Grid>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="QuickAddHotkeyTextBox" Grid.Column="0" Header="Quick Add to Dictionary" IsReadOnly="True" PlaceholderText="Ctrl+Alt+D" KeyDown="ShortcutTextBox_KeyDown" />
                                <Button Grid.Column="1" MinWidth="80" Margin="0,28,0,0" Content="Record" Tag="QuickAddHotkeyTextBox" Click="ShortcutRecorderButton_Click" />
                            </Grid>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="ToggleEnhancementHotkeyTextBox" Grid.Column="0" Header="Toggle Enhancement" IsReadOnly="True" PlaceholderText="Ctrl+Alt+X" KeyDown="ShortcutTextBox_KeyDown" />
                                <Button Grid.Column="1" MinWidth="80" Margin="0,28,0,0" Content="Record" Tag="ToggleEnhancementHotkeyTextBox" Click="ShortcutRecorderButton_Click" />
                            </Grid>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="CyclePowerModeHotkeyTextBox" Grid.Column="0" Header="Cycle Power Mode" IsReadOnly="True" PlaceholderText="Ctrl+Alt+P" KeyDown="ShortcutTextBox_KeyDown" />
                                <Button Grid.Column="1" MinWidth="80" Margin="0,28,0,0" Content="Record" Tag="CyclePowerModeHotkeyTextBox" Click="ShortcutRecorderButton_Click" />
                            </Grid>
                            <Button
                                x:Name="ApplyShortcutsButton"
                                Content="Apply Shortcuts"
                                Click="ApplyShortcutsButton_Click" />
                        </StackPanel>

                        <StackPanel Spacing="8">
                            <TextBlock Text="Recording Feedback" FontWeight="SemiBold" />
                            <TextBlock x:Name="RecordingFeedbackSectionDescriptionTextBlock" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            <CheckBox
                                x:Name="SoundFeedbackCheckBox"
                                Content="Sound Feedback"
                                Checked="RecordingFeedbackSetting_Changed"
                                Unchecked="RecordingFeedbackSetting_Changed" />
                            <ComboBox
                                x:Name="StartSoundComboBox"
                                Header="Start Sound"
                                SelectedIndex="0"
                                SelectionChanged="RecordingFeedbackSettingComboBox_SelectionChanged">
                                <ComboBoxItem Content="System Default" />
                                <ComboBoxItem x:Name="StartCustomSoundComboBoxItem" Content="Custom Sound" />
                            </ComboBox>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button
                                    x:Name="TestStartSoundButton"
                                    Content="Test"
                                    Click="TestStartSoundButton_Click" />
                                <Button
                                    x:Name="ChooseStartSoundButton"
                                    Content="Choose"
                                    Click="ChooseStartSoundButton_Click" />
                                <Button
                                    x:Name="ResetStartSoundButton"
                                    Content="Reset"
                                    Click="ResetStartSoundButton_Click" />
                            </StackPanel>
                            <TextBlock
                                x:Name="StartSoundStatusTextBlock"
                                Text="No custom sound"
                                TextWrapping="Wrap"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <ComboBox
                                x:Name="StopSoundComboBox"
                                Header="Stop Sound"
                                SelectedIndex="0"
                                SelectionChanged="RecordingFeedbackSettingComboBox_SelectionChanged">
                                <ComboBoxItem Content="System Default" />
                                <ComboBoxItem x:Name="StopCustomSoundComboBoxItem" Content="Custom Sound" />
                            </ComboBox>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button
                                    x:Name="TestStopSoundButton"
                                    Content="Test"
                                    Click="TestStopSoundButton_Click" />
                                <Button
                                    x:Name="ChooseStopSoundButton"
                                    Content="Choose"
                                    Click="ChooseStopSoundButton_Click" />
                                <Button
                                    x:Name="ResetStopSoundButton"
                                    Content="Reset"
                                    Click="ResetStopSoundButton_Click" />
                            </StackPanel>
                            <TextBlock
                                x:Name="StopSoundStatusTextBlock"
                                Text="No custom sound"
                                TextWrapping="Wrap"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <CheckBox
                                x:Name="MuteSystemAudioCheckBox"
                                Content="Mute Audio While Recording"
                                Checked="RecordingFeedbackSetting_Changed"
                                Unchecked="RecordingFeedbackSetting_Changed" />
                            <CheckBox
                                x:Name="PauseMediaCheckBox"
                                Content="Pause Media While Recording"
                                Checked="RecordingFeedbackSetting_Changed"
                                Unchecked="RecordingFeedbackSetting_Changed" />
                            <ComboBox
                                x:Name="AudioResumptionDelayComboBox"
                                Header="Resume Delay"
                                SelectedIndex="0"
                                SelectionChanged="RecordingFeedbackSettingComboBox_SelectionChanged">
                                <ComboBoxItem Content="0s" />
                                <ComboBoxItem Content="1s" />
                                <ComboBoxItem Content="2s" />
                                <ComboBoxItem Content="3s" />
                                <ComboBoxItem Content="4s" />
                                <ComboBoxItem Content="5s" />
                            </ComboBox>
                            <Button
                                x:Name="ApplyRecordingFeedbackSettingsButton"
                                Content="Apply Recording Feedback"
                                Click="ApplyRecordingFeedbackSettingsButton_Click" />
                        </StackPanel>

                        <StackPanel Spacing="8">
                            <TextBlock Text="Interface" FontWeight="SemiBold" />
                            <TextBlock x:Name="InterfaceSectionDescriptionTextBlock" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            <ComboBox
                                x:Name="RecorderStyleComboBox"
                                Header="Recorder Style"
                                SelectedIndex="0"
                                SelectionChanged="RecorderStyleComboBox_SelectionChanged">
                                <ComboBoxItem Content="Mini" />
                                <ComboBoxItem Content="Notch" />
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Spacing="8">
                            <TextBlock Text="Clipboard" FontWeight="SemiBold" />
                            <TextBlock x:Name="ClipboardSectionDescriptionTextBlock" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            <CheckBox
                                x:Name="RestoreClipboardCheckBox"
                                Content="Keep Clipboard Content"
                                Checked="ClipboardSetting_Changed"
                                Unchecked="ClipboardSetting_Changed" />
                            <ComboBox
                                x:Name="ClipboardRestoreDelayComboBox"
                                Header="Restore Delay"
                                SelectedIndex="3">
                                <ComboBoxItem Content="250ms" />
                                <ComboBoxItem Content="500ms" />
                                <ComboBoxItem Content="1s" />
                                <ComboBoxItem Content="2s" />
                                <ComboBoxItem Content="3s" />
                                <ComboBoxItem Content="4s" />
                                <ComboBoxItem Content="5s" />
                            </ComboBox>
                            <ComboBox
                                x:Name="PasteMethodComboBox"
                                Header="Paste Method"
                                SelectedIndex="0"
                                SelectionChanged="ClipboardSettingComboBox_SelectionChanged">
                                <ComboBoxItem Content="Default" />
                                <ComboBoxItem Content="Direct Text" />
                            </ComboBox>
                            <Button
                                x:Name="ApplyClipboardSettingsButton"
                                Content="Apply Clipboard Settings"
                                Click="ApplyClipboardSettingsButton_Click" />
                        </StackPanel>

                        <StackPanel Spacing="8">
                            <TextBlock Text="Cleanup" FontWeight="SemiBold" />
                            <TextBlock x:Name="CleanupSectionDescriptionTextBlock" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            <CheckBox x:Name="RemoveFillerWordsCheckBox" Content="Remove filler words" />
                            <CheckBox x:Name="LowercaseTranscriptionCheckBox" Content="Lowercase transcription" />
                            <CheckBox x:Name="AppendTrailingSpaceCheckBox" Content="Append trailing space" />
                            <ComboBox x:Name="PunctuationCleanupComboBox" Header="Punctuation cleanup" SelectedIndex="0">
                                <ComboBoxItem Content="Keep" />
                                <ComboBoxItem Content="Remove all" />
                                <ComboBoxItem Content="Remove trailing period" />
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Spacing="8">
                            <TextBlock Text="Privacy" FontWeight="SemiBold" />
                            <TextBlock x:Name="PrivacySectionDescriptionTextBlock" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            <CheckBox
                                x:Name="TranscriptionCleanupCheckBox"
                                Content="Auto-delete Transcripts"
                                Checked="CleanupSettingCheckBox_Changed"
                                Unchecked="CleanupSettingCheckBox_Changed" />
                            <ComboBox
                                x:Name="TranscriptionRetentionComboBox"
                                Header="Delete After"
                                SelectedIndex="2">
                                <ComboBoxItem Content="Immediately" />
                                <ComboBoxItem Content="1 hour" />
                                <ComboBoxItem Content="1 day" />
                                <ComboBoxItem Content="3 days" />
                                <ComboBoxItem Content="7 days" />
                            </ComboBox>
                            <Button
                                x:Name="RunTranscriptCleanupButton"
                                Content="Run Transcript Cleanup Now"
                                Click="RunTranscriptCleanupButton_Click" />
                            <StackPanel x:Name="AudioCleanupSettingsPanel" Spacing="8">
                                <CheckBox
                                    x:Name="AudioCleanupCheckBox"
                                    Content="Auto-delete Audio Files"
                                    Checked="CleanupSettingCheckBox_Changed"
                                    Unchecked="CleanupSettingCheckBox_Changed" />
                                <ComboBox
                                    x:Name="AudioRetentionComboBox"
                                    Header="Keep Audio For"
                                    SelectedIndex="2">
                                    <ComboBoxItem Content="1 day" />
                                    <ComboBoxItem Content="3 days" />
                                    <ComboBoxItem Content="7 days" />
                                    <ComboBoxItem Content="14 days" />
                                    <ComboBoxItem Content="30 days" />
                                </ComboBox>
                                <Button
                                    x:Name="RunAudioCleanupButton"
                                    Content="Run Audio Cleanup Now"
                                    Click="RunAudioCleanupButton_Click" />
                            </StackPanel>
                            <Button
                                x:Name="ApplyCleanupSettingsButton"
                                Content="Apply Cleanup Settings"
                                Click="ApplyCleanupSettingsButton_Click" />
                        </StackPanel>

                        <StackPanel Spacing="8">
                            <TextBlock Text="General" FontWeight="SemiBold" />
                            <TextBlock x:Name="GeneralSectionDescriptionTextBlock" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            <CheckBox
                                x:Name="LaunchAtLoginCheckBox"
                                Content="Launch at Login"
                                Checked="LaunchAtLoginCheckBox_Changed"
                                Unchecked="LaunchAtLoginCheckBox_Changed" />
                            <Button
                                x:Name="RepairLaunchAtLoginButton"
                                Content="Reapply Launch at Login"
                                Click="RepairLaunchAtLoginButton_Click" />
                            <Button
                                x:Name="ResetOnboardingButton"
                                Content="Reset Onboarding"
                                Click="ResetOnboardingButton_Click" />
                        </StackPanel>

                        <StackPanel Spacing="8">
                            <TextBlock Text="Backup" FontWeight="SemiBold" />
                            <TextBlock x:Name="BackupSectionDescriptionTextBlock" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button
                                    x:Name="ExportSettingsBackupButton"
                                    Content="Export Settings"
                                    Click="ExportSettingsBackupButton_Click" />
                                <Button
                                    x:Name="ImportSettingsBackupButton"
                                    Content="Import Settings"
                                    Click="ImportSettingsBackupButton_Click" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel x:Name="AboutSectionPanel" Spacing="12" Visibility="Collapsed">
                        <TextBlock Text="About / Open Source" FontSize="24" FontWeight="SemiBold" />
                        <TextBlock x:Name="AboutVersionTextBlock" TextWrapping="Wrap" />
                        <TextBlock Text="GPL-3.0 open-source Windows fork" TextWrapping="Wrap" />
                        <TextBlock x:Name="DiagnosticsSectionDescriptionTextBlock" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        <TextBox
                            x:Name="RuntimePathTextBox"
                            Header="Runtime path"
                            IsReadOnly="True"
                            TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button
                                x:Name="OpenDiagnosticsFolderButton"
                                Content="Open Diagnostics Folder"
                                Click="OpenDiagnosticsFolderButton_Click" />
                            <Button
                                x:Name="CopyDiagnosticsSummaryButton"
                                Content="Copy Diagnostics Summary"
                                Click="CopyDiagnosticsSummaryButton_Click" />
                            <Button
                                x:Name="ExportDiagnosticLogsButton"
                                Content="Export Diagnostic Logs"
                                Click="ExportDiagnosticLogsButton_Click" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </ScrollViewer>

            <TextBlock
                x:Name="StatusTextBlock"
                Grid.Row="1"
                Text="Idle"
                TextWrapping="Wrap" />
        </Grid>
    </NavigationView>
</Window>
