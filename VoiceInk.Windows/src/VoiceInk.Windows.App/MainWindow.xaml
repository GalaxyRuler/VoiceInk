<Window
    x:Class="VoiceInk.Windows.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="VoiceInk for Windows">

    <NavigationView
        x:Name="RootNavigationView"
        IsBackButtonVisible="Collapsed"
        IsSettingsVisible="False"
        PaneTitle="VoiceInk"
        SelectionChanged="RootNavigationView_SelectionChanged">
        <Grid RowSpacing="12" Padding="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ScrollViewer Grid.Row="0">
                <Grid>
                    <StackPanel x:Name="DashboardSectionPanel" Spacing="16">
                        <TextBlock Text="Dashboard" FontSize="24" FontWeight="SemiBold" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="StartButton" Content="Start Recording" Click="StartButton_Click" />
                            <Button x:Name="StopButton" Content="Stop And Insert" Click="StopButton_Click" IsEnabled="False" />
                            <Button x:Name="CancelButton" Content="Cancel Recording" Click="CancelButton_Click" IsEnabled="False" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel x:Name="TranscribeAudioSectionPanel" Spacing="12" Visibility="Collapsed">
                        <TextBlock Text="Transcribe Audio" FontSize="24" FontWeight="SemiBold" />
                        <TextBlock
                            Text="Choose audio or video files, then process them sequentially with the current transcription provider and cleanup settings."
                            TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button
                                x:Name="ChooseAudioFilesButton"
                                Content="Choose Files"
                                Click="ChooseAudioFilesButton_Click" />
                            <Button
                                x:Name="StartAudioFileQueueButton"
                                Content="Start"
                                Click="StartAudioFileQueueButton_Click" />
                            <Button
                                x:Name="CancelAudioFileQueueButton"
                                Content="Cancel"
                                Click="CancelAudioFileQueueButton_Click" />
                            <Button
                                x:Name="ClearAudioFileQueueButton"
                                Content="Clear"
                                Click="ClearAudioFileQueueButton_Click" />
                            <Button
                                x:Name="RemoveAudioFileQueueItemButton"
                                Content="Remove"
                                Click="RemoveAudioFileQueueItemButton_Click" />
                            <Button
                                x:Name="RetryAudioFileQueueItemButton"
                                Content="Retry"
                                Click="RetryAudioFileQueueItemButton_Click" />
                        </StackPanel>
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="3*" />
                            </Grid.ColumnDefinitions>
                            <ListView
                                x:Name="AudioFileQueueListView"
                                Grid.Column="0"
                                Height="260"
                                SelectionChanged="AudioFileQueueListView_SelectionChanged"
                                SelectionMode="Single" />
                            <StackPanel Grid.Column="1" Spacing="8">
                                <TextBlock
                                    x:Name="AudioFileQueueMetadataTextBlock"
                                    Text="No files queued"
                                    TextWrapping="Wrap" />
                                <TextBox
                                    x:Name="AudioFileQueueTranscriptTextBox"
                                    Header="Transcript"
                                    AcceptsReturn="True"
                                    Height="180"
                                    IsReadOnly="True"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                        <TextBlock
                            Text="Supported formats depend on Windows Media Foundation codecs. WAV, MP3, M4A, MP4, MOV, AAC, WMA, WMV, AVI, 3GP, 3G2, and FLAC are accepted by the picker."
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel x:Name="ModelsSectionPanel" Spacing="12" Visibility="Collapsed">
                        <TextBlock Text="AI Models" FontSize="24" FontWeight="SemiBold" />
                        <TextBox
                            x:Name="ModelPathTextBox"
                            Header="Local whisper model path"
                            PlaceholderText="C:\Models\ggml-base.en.bin"
                            TextChanged="ModelPathTextBox_TextChanged" />
                        <ComboBox
                            x:Name="ModelComboBox"
                            Header="Imported Local Models"
                            PlaceholderText="No local models imported"
                            SelectionChanged="ModelComboBox_SelectionChanged" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button
                                x:Name="ImportModelButton"
                                Content="Import Model"
                                Click="ImportModelButton_Click" />
                            <Button
                                x:Name="UseSelectedModelButton"
                                Content="Use Selected Model"
                                Click="UseSelectedModelButton_Click" />
                            <Button
                                x:Name="OpenModelDownloadsButton"
                                Content="Open GGML Model Downloads"
                                Click="OpenModelDownloadsButton_Click" />
                        </StackPanel>
                        <ComboBox
                            x:Name="TranscriptionProviderComboBox"
                            Header="Transcription Provider"
                            SelectionChanged="TranscriptionProviderComboBox_SelectionChanged">
                            <ComboBoxItem Content="Local Whisper" />
                            <ComboBoxItem Content="OpenAI-compatible" />
                        </ComboBox>
                        <ComboBox
                            x:Name="CloudTranscriptionPresetComboBox"
                            DisplayMemberPath="DisplayName"
                            Header="Cloud provider preset"
                            SelectionChanged="CloudTranscriptionPresetComboBox_SelectionChanged" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBox
                                x:Name="CloudTranscriptionEndpointTextBox"
                                Grid.Column="0"
                                Header="Cloud transcription endpoint"
                                PlaceholderText="https://api.example.com/v1/audio/transcriptions" />
                            <TextBox
                                x:Name="CloudTranscriptionModelTextBox"
                                Grid.Column="1"
                                Header="Cloud transcription model"
                                PlaceholderText="gpt-4o-transcribe" />
                        </Grid>
                        <ComboBox
                            x:Name="CloudTranscriptionModelComboBox"
                            Header="Preset model"
                            SelectionChanged="CloudTranscriptionModelComboBox_SelectionChanged" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <PasswordBox
                                x:Name="CloudTranscriptionApiKeyPasswordBox"
                                Grid.Column="0"
                                Header="Cloud transcription API key" />
                            <Button
                                x:Name="SaveCloudTranscriptionKeyButton"
                                Grid.Column="1"
                                Content="Save Key"
                                Click="SaveCloudTranscriptionKeyButton_Click" />
                            <Button
                                x:Name="ClearCloudTranscriptionKeyButton"
                                Grid.Column="2"
                                Content="Clear Key"
                                Click="ClearCloudTranscriptionKeyButton_Click" />
                        </Grid>
                        <TextBlock
                            x:Name="CloudTranscriptionKeyStatusTextBlock"
                            Text="Cloud transcription API key not checked"
                            TextWrapping="Wrap" />
                        <Button
                            x:Name="ApplyTranscriptionProviderSettingsButton"
                            Content="Apply Transcription Provider Settings"
                            Click="ApplyTranscriptionProviderSettingsButton_Click" />
                    </StackPanel>

                    <StackPanel x:Name="EnhancementSectionPanel" Spacing="12" Visibility="Collapsed">
                        <TextBlock Text="Enhancement" FontSize="24" FontWeight="SemiBold" />
                        <CheckBox
                            x:Name="EnhancementEnabledCheckBox"
                            Content="Enable Enhancement" />
                        <CheckBox
                            x:Name="UseClipboardContextCheckBox"
                            Content="Clipboard Context" />
                        <ComboBox
                            x:Name="EnhancementProviderPresetComboBox"
                            DisplayMemberPath="DisplayName"
                            Header="AI provider"
                            SelectionChanged="EnhancementProviderPresetComboBox_SelectionChanged" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBox
                                x:Name="EnhancementEndpointTextBox"
                                Grid.Column="0"
                                Header="OpenAI-compatible endpoint"
                                PlaceholderText="https://api.example.com/v1/chat/completions" />
                            <TextBox
                                x:Name="EnhancementModelTextBox"
                                Grid.Column="1"
                                Header="Model"
                                PlaceholderText="model-name" />
                        </Grid>
                        <ComboBox
                            x:Name="EnhancementModelComboBox"
                            Header="Preset model"
                            SelectionChanged="EnhancementModelComboBox_SelectionChanged" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <PasswordBox
                                x:Name="EnhancementApiKeyPasswordBox"
                                Grid.Column="0"
                                Header="API key" />
                            <Button
                                x:Name="SaveEnhancementKeyButton"
                                Grid.Column="1"
                                Content="Save Key"
                                Click="SaveEnhancementKeyButton_Click" />
                            <Button
                                x:Name="ClearEnhancementKeyButton"
                                Grid.Column="2"
                                Content="Clear Key"
                                Click="ClearEnhancementKeyButton_Click" />
                        </Grid>
                        <TextBlock
                            x:Name="EnhancementKeyStatusTextBlock"
                            Text="API key not checked"
                            TextWrapping="Wrap" />
                        <ComboBox
                            x:Name="EnhancementPromptComboBox"
                            Header="Prompt"
                            SelectionChanged="EnhancementPromptComboBox_SelectionChanged" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBox
                                x:Name="PromptTitleTextBox"
                                Grid.Column="0"
                                Header="Prompt title"
                                PlaceholderText="Prompt name" />
                            <TextBox
                                x:Name="PromptTriggerWordsTextBox"
                                Grid.Column="1"
                                Header="Trigger words"
                                PlaceholderText="chat mode, email mode" />
                        </Grid>
                        <TextBox
                            x:Name="PromptInstructionsTextBox"
                            Header="Prompt instructions"
                            AcceptsReturn="True"
                            Height="140"
                            TextWrapping="Wrap"
                            PlaceholderText="Enter custom prompt instructions" />
                        <CheckBox
                            x:Name="PromptUseSystemInstructionsCheckBox"
                            Content="Use transcription enhancement instructions" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button
                                x:Name="NewPromptButton"
                                Content="New Prompt"
                                Click="NewPromptButton_Click" />
                            <Button
                                x:Name="SavePromptButton"
                                Content="Save Prompt"
                                Click="SavePromptButton_Click" />
                            <Button
                                x:Name="DeletePromptButton"
                                Content="Delete Prompt"
                                Click="DeletePromptButton_Click" />
                        </StackPanel>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBox
                                x:Name="EnhancementTimeoutTextBox"
                                Grid.Column="0"
                                Header="Timeout seconds"
                                PlaceholderText="7" />
                            <TextBox
                                x:Name="ShortEnhancementThresholdTextBox"
                                Grid.Column="1"
                                Header="Short enhancement threshold"
                                PlaceholderText="3" />
                        </Grid>
                        <StackPanel Spacing="8">
                            <CheckBox
                                x:Name="SkipShortEnhancementCheckBox"
                                Content="Skip enhancement for short phrases" />
                            <CheckBox
                                x:Name="EnhancementRetryOnTimeoutCheckBox"
                                Content="Retry on timeout" />
                        </StackPanel>
                        <Button
                            x:Name="ApplyEnhancementSettingsButton"
                            Content="Apply Enhancement Settings"
                            Click="ApplyEnhancementSettingsButton_Click" />
                    </StackPanel>

                    <StackPanel x:Name="PowerModeSectionPanel" Spacing="12" Visibility="Collapsed">
                        <TextBlock Text="Power Mode" FontSize="24" FontWeight="SemiBold" />
                        <TextBlock
                            x:Name="PowerModeActiveWindowTextBlock"
                            Text="Active window not checked"
                            TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button
                                x:Name="RefreshPowerModeTargetButton"
                                Content="Refresh Active Window"
                                Click="RefreshPowerModeTargetButton_Click" />
                            <Button
                                x:Name="UsePowerModeTargetButton"
                                Content="Use Active Window"
                                Click="UsePowerModeTargetButton_Click" />
                        </StackPanel>

                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="3*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="8">
                                <ListView
                                    x:Name="PowerModeRulesListView"
                                    Height="260"
                                    SelectionChanged="PowerModeRulesListView_SelectionChanged"
                                    SelectionMode="Single" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button
                                        x:Name="MovePowerModeRuleUpButton"
                                        Content="Move Up"
                                        Click="MovePowerModeRuleUpButton_Click" />
                                    <Button
                                        x:Name="MovePowerModeRuleDownButton"
                                        Content="Move Down"
                                        Click="MovePowerModeRuleDownButton_Click" />
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="8">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox
                                        x:Name="PowerModeNameTextBox"
                                        Grid.Column="0"
                                        Header="Name"
                                        PlaceholderText="Chat" />
                                    <TextBox
                                        x:Name="PowerModeEmojiTextBox"
                                        Grid.Column="1"
                                        Header="Emoji"
                                        PlaceholderText="C" />
                                </Grid>
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox
                                        x:Name="PowerModeProcessTextBox"
                                        Grid.Column="0"
                                        Header="Process contains"
                                        PlaceholderText="teams" />
                                    <TextBox
                                        x:Name="PowerModeWindowTitleTextBox"
                                        Grid.Column="1"
                                        Header="Window title contains"
                                        PlaceholderText="chat" />
                                </Grid>
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <CheckBox
                                        x:Name="PowerModeEnabledCheckBox"
                                        Content="Enabled"
                                        IsChecked="True" />
                                    <CheckBox
                                        x:Name="PowerModeDefaultCheckBox"
                                        Content="Default" />
                                </StackPanel>
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox
                                        x:Name="PowerModeModelPathTextBox"
                                        Grid.Column="0"
                                        Header="Model override"
                                        PlaceholderText="C:\Models\ggml-base.en.bin" />
                                    <TextBox
                                        x:Name="PowerModeLanguageTextBox"
                                        Grid.Column="1"
                                        Header="Language override"
                                        PlaceholderText="en" />
                                </Grid>
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox
                                        x:Name="PowerModeEnhancementOverrideComboBox"
                                        Grid.Column="0"
                                        Header="Enhancement override"
                                        SelectedIndex="0">
                                        <ComboBoxItem Content="Keep base" />
                                        <ComboBoxItem Content="Enable" />
                                        <ComboBoxItem Content="Disable" />
                                    </ComboBox>
                                    <ComboBox
                                        x:Name="PowerModePromptOverrideComboBox"
                                        Grid.Column="1"
                                        Header="Prompt override" />
                                </Grid>
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox
                                        x:Name="PowerModeAppendTrailingSpaceCheckBox"
                                        Grid.Column="0"
                                        Content="Trailing space"
                                        IsThreeState="True" />
                                    <CheckBox
                                        x:Name="PowerModeRemoveFillerWordsCheckBox"
                                        Grid.Column="1"
                                        Content="Remove fillers"
                                        IsThreeState="True" />
                                    <CheckBox
                                        x:Name="PowerModeLowercaseCheckBox"
                                        Grid.Column="2"
                                        Content="Lowercase"
                                        IsThreeState="True" />
                                </Grid>
                                <ComboBox
                                    x:Name="PowerModePunctuationCleanupComboBox"
                                    Header="Punctuation cleanup override"
                                    SelectedIndex="0">
                                    <ComboBoxItem Content="Keep base" />
                                    <ComboBoxItem Content="Keep punctuation" />
                                    <ComboBoxItem Content="Remove all" />
                                    <ComboBoxItem Content="Remove trailing period" />
                                </ComboBox>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button
                                        x:Name="AddPowerModeRuleButton"
                                        Content="Add Rule"
                                        Click="AddPowerModeRuleButton_Click" />
                                    <Button
                                        x:Name="UpdatePowerModeRuleButton"
                                        Content="Update Rule"
                                        Click="UpdatePowerModeRuleButton_Click" />
                                    <Button
                                        x:Name="RemovePowerModeRuleButton"
                                        Content="Remove Rule"
                                        Click="RemovePowerModeRuleButton_Click" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <StackPanel x:Name="AudioInputSectionPanel" Spacing="12" Visibility="Collapsed">
                        <TextBlock Text="Audio Input" FontSize="24" FontWeight="SemiBold" />
                        <ComboBox
                            x:Name="AudioInputComboBox"
                            Header="Microphone"
                            PlaceholderText="System Default" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button
                                x:Name="RefreshAudioInputsButton"
                                Content="Refresh"
                                Click="RefreshAudioInputsButton_Click" />
                            <Button
                                x:Name="ApplyAudioInputButton"
                                Content="Apply Audio Input"
                                Click="ApplyAudioInputButton_Click" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel x:Name="DictionarySectionPanel" Spacing="12" Visibility="Collapsed">
                        <TextBlock Text="Dictionary" FontSize="24" FontWeight="SemiBold" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button
                                x:Name="ExportDictionaryButton"
                                Content="Export Dictionary"
                                Click="ExportDictionaryButton_Click" />
                            <Button
                                x:Name="ImportDictionaryButton"
                                Content="Import Dictionary"
                                Click="ImportDictionaryButton_Click" />
                            <Button
                                x:Name="QuickAddDictionaryButton"
                                Content="Quick Add"
                                Click="QuickAddDictionaryButton_Click" />
                        </StackPanel>

                        <StackPanel Spacing="8">
                            <TextBlock Text="Vocabulary" FontWeight="SemiBold" />
                            <ComboBox
                                x:Name="VocabularySortComboBox"
                                Header="Sort"
                                SelectedIndex="0"
                                SelectionChanged="DictionarySortComboBox_SelectionChanged">
                                <ComboBoxItem Content="Word A-Z" />
                                <ComboBoxItem Content="Word Z-A" />
                            </ComboBox>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox
                                    x:Name="VocabularyInputTextBox"
                                    Grid.Column="0"
                                    PlaceholderText="Add word to vocabulary" />
                                <Button
                                    x:Name="AddVocabularyButton"
                                    Grid.Column="1"
                                    Content="Add"
                                    Click="AddVocabularyButton_Click" />
                                <Button
                                    x:Name="RemoveVocabularyButton"
                                    Grid.Column="2"
                                    Content="Remove"
                                    Click="RemoveVocabularyButton_Click" />
                            </Grid>
                            <ListView
                                x:Name="VocabularyListView"
                                Height="120"
                                SelectionMode="Single" />
                        </StackPanel>

                        <StackPanel Spacing="8">
                            <TextBlock Text="Word Replacements" FontWeight="SemiBold" />
                            <ComboBox
                                x:Name="ReplacementSortComboBox"
                                Header="Sort"
                                SelectedIndex="0"
                                SelectionChanged="DictionarySortComboBox_SelectionChanged">
                                <ComboBoxItem Content="Original A-Z" />
                                <ComboBoxItem Content="Original Z-A" />
                                <ComboBoxItem Content="Replacement A-Z" />
                                <ComboBoxItem Content="Replacement Z-A" />
                            </ComboBox>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox
                                    x:Name="ReplacementOriginalTextBox"
                                    Grid.Column="0"
                                    Header="Original text"
                                    PlaceholderText="Voice ink, Voicing" />
                                <TextBox
                                    x:Name="ReplacementTextBox"
                                    Grid.Column="1"
                                    Header="Replacement text"
                                    PlaceholderText="VoiceInk" />
                                <Button
                                    x:Name="AddReplacementButton"
                                    Grid.Column="2"
                                    Content="Add"
                                    Click="AddReplacementButton_Click" />
                                <Button
                                    x:Name="RemoveReplacementButton"
                                    Grid.Column="3"
                                    Content="Remove"
                                    Click="RemoveReplacementButton_Click" />
                                <Button
                                    x:Name="EditReplacementButton"
                                    Grid.Column="4"
                                    Content="Edit"
                                    Click="EditReplacementButton_Click" />
                                <Button
                                    x:Name="ToggleReplacementButton"
                                    Grid.Column="5"
                                    Content="Disable"
                                    Click="ToggleReplacementButton_Click" />
                            </Grid>
                            <ListView
                                x:Name="ReplacementListView"
                                Height="140"
                                SelectionChanged="ReplacementListView_SelectionChanged"
                                SelectionMode="Single" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel x:Name="HistorySectionPanel" Spacing="12" Visibility="Collapsed">
                        <TextBlock Text="History" FontSize="24" FontWeight="SemiBold" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox
                                x:Name="HistorySearchTextBox"
                                Grid.Column="0"
                                PlaceholderText="Search transcriptions..." />
                            <Button x:Name="SearchHistoryButton" Grid.Column="1" Content="Search" Click="SearchHistoryButton_Click" />
                            <Button x:Name="ClearHistorySearchButton" Grid.Column="2" Content="Clear" Click="ClearHistorySearchButton_Click" />
                            <Button x:Name="RefreshHistoryButton" Grid.Column="3" Content="Refresh" Click="RefreshHistoryButton_Click" />
                            <Button x:Name="ExportHistoryButton" Grid.Column="4" Content="Export CSV" Click="ExportHistoryButton_Click" />
                            <Button x:Name="PasteLastButton" Grid.Column="5" Content="Paste Last" Click="PasteLastButton_Click" />
                            <Button x:Name="PasteLastEnhancedButton" Grid.Column="6" Content="Paste Last Enhanced" Click="PasteLastEnhancedButton_Click" />
                            <Button x:Name="RetryLastButton" Grid.Column="7" Content="Retry Last" Click="RetryLastButton_Click" />
                        </Grid>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="RetryHistoryButton" Content="Retry Selected" Click="RetryHistoryButton_Click" />
                            <Button x:Name="OpenHistoryAudioButton" Content="Open Audio" Click="OpenHistoryAudioButton_Click" />
                            <Button x:Name="DeleteHistoryButton" Content="Delete" Click="DeleteHistoryButton_Click" />
                        </StackPanel>
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="3*" />
                            </Grid.ColumnDefinitions>
                            <ListView
                                x:Name="HistoryListView"
                                Grid.Column="0"
                                Height="220"
                                SelectionChanged="HistoryListView_SelectionChanged"
                                SelectionMode="Single" />
                            <StackPanel Grid.Column="1" Spacing="8">
                                <TextBlock x:Name="HistoryMetadataTextBlock" Text="Select a transcription" TextWrapping="Wrap" />
                                <TextBox
                                    x:Name="HistoryOriginalTextBox"
                                    Header="Original"
                                    AcceptsReturn="True"
                                    Height="80"
                                    IsReadOnly="True"
                                    TextWrapping="Wrap" />
                                <TextBox
                                    x:Name="HistoryFinalTextBox"
                                    Header="Final"
                                    AcceptsReturn="True"
                                    Height="80"
                                    IsReadOnly="True"
                                    TextWrapping="Wrap" />
                                <TextBox
                                    x:Name="HistoryEnhancedTextBox"
                                    Header="Enhanced"
                                    AcceptsReturn="True"
                                    Height="80"
                                    IsReadOnly="True"
                                    TextWrapping="Wrap" />
                                <MediaPlayerElement
                                    x:Name="HistoryAudioPlayer"
                                    Height="72"
                                    AreTransportControlsEnabled="True"
                                    Visibility="Collapsed" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <StackPanel x:Name="MetricsSectionPanel" Spacing="12" Visibility="Collapsed">
                        <TextBlock Text="Metrics" FontSize="24" FontWeight="SemiBold" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ComboBox
                                x:Name="MetricsTimeFilterComboBox"
                                DisplayMemberPath="Label"
                                Header="Time Filter"
                                SelectionChanged="MetricsTimeFilterComboBox_SelectionChanged" />
                            <Button
                                x:Name="RefreshMetricsButton"
                                Content="Refresh Metrics"
                                Click="RefreshMetricsButton_Click" />
                            <Button
                                x:Name="ExportMetricsButton"
                                Content="Export Metrics CSV"
                                Click="ExportMetricsButton_Click" />
                        </StackPanel>
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="8">
                                <TextBlock Text="Dashboard" FontWeight="SemiBold" />
                                <TextBlock
                                    x:Name="MetricsSummaryTextBlock"
                                    Text="Metrics not loaded"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="8">
                                <TextBlock Text="Storage" FontWeight="SemiBold" />
                                <TextBox
                                    x:Name="MetricsDatabasePathTextBox"
                                    Header="Metrics database"
                                    IsReadOnly="True"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="8">
                                <TextBlock Text="Transcription Models" FontWeight="SemiBold" />
                                <ListView
                                    x:Name="TranscriptionModelPerformanceListView"
                                    Height="180"
                                    SelectionMode="None" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="8">
                                <TextBlock Text="Enhancement Models" FontWeight="SemiBold" />
                                <ListView
                                    x:Name="EnhancementModelPerformanceListView"
                                    Height="180"
                                    SelectionMode="None" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <StackPanel x:Name="SettingsSectionPanel" Spacing="12" Visibility="Collapsed">
                        <TextBlock Text="Settings" FontSize="24" FontWeight="SemiBold" />
                        <StackPanel Spacing="8">
                            <TextBlock Text="Shortcuts" FontWeight="SemiBold" />
                            <TextBox
                                x:Name="RecordingHotkeyTextBox"
                                Header="Primary Shortcut"
                                PlaceholderText="Ctrl+Alt+Space" />
                            <TextBox
                                x:Name="SecondaryRecordingHotkeyTextBox"
                                Header="Secondary Shortcut"
                                PlaceholderText="Ctrl+Alt+S" />
                            <TextBox
                                x:Name="PasteLastHotkeyTextBox"
                                Header="Paste Last Transcription"
                                PlaceholderText="Ctrl+Alt+V" />
                            <TextBox
                                x:Name="PasteLastEnhancedHotkeyTextBox"
                                Header="Paste Last Enhanced Transcription"
                                PlaceholderText="Ctrl+Alt+E" />
                            <TextBox
                                x:Name="RetryLastHotkeyTextBox"
                                Header="Retry Last Transcription"
                                PlaceholderText="Ctrl+Alt+R" />
                            <TextBox
                                x:Name="CancelHotkeyTextBox"
                                Header="Cancel Recording"
                                PlaceholderText="Ctrl+Alt+C" />
                            <TextBox
                                x:Name="OpenHistoryHotkeyTextBox"
                                Header="Open History Window"
                                PlaceholderText="Ctrl+Alt+H" />
                            <TextBox
                                x:Name="QuickAddHotkeyTextBox"
                                Header="Quick Add to Dictionary"
                                PlaceholderText="Ctrl+Alt+D" />
                            <Button
                                x:Name="ApplyShortcutsButton"
                                Content="Apply Shortcuts"
                                Click="ApplyShortcutsButton_Click" />
                        </StackPanel>

                        <StackPanel Spacing="8">
                            <TextBlock Text="Clipboard" FontWeight="SemiBold" />
                            <CheckBox
                                x:Name="RestoreClipboardCheckBox"
                                Content="Keep Clipboard Content"
                                Checked="ClipboardSetting_Changed"
                                Unchecked="ClipboardSetting_Changed" />
                            <ComboBox
                                x:Name="ClipboardRestoreDelayComboBox"
                                Header="Restore Delay"
                                SelectedIndex="3">
                                <ComboBoxItem Content="250ms" />
                                <ComboBoxItem Content="500ms" />
                                <ComboBoxItem Content="1s" />
                                <ComboBoxItem Content="2s" />
                                <ComboBoxItem Content="3s" />
                                <ComboBoxItem Content="4s" />
                                <ComboBoxItem Content="5s" />
                            </ComboBox>
                            <ComboBox
                                x:Name="PasteMethodComboBox"
                                Header="Paste Method"
                                SelectedIndex="0"
                                SelectionChanged="ClipboardSettingComboBox_SelectionChanged">
                                <ComboBoxItem Content="Default" />
                                <ComboBoxItem Content="Direct Text" />
                            </ComboBox>
                            <Button
                                x:Name="ApplyClipboardSettingsButton"
                                Content="Apply Clipboard Settings"
                                Click="ApplyClipboardSettingsButton_Click" />
                        </StackPanel>

                        <StackPanel Spacing="8">
                            <TextBlock Text="Cleanup" FontWeight="SemiBold" />
                            <CheckBox x:Name="RemoveFillerWordsCheckBox" Content="Remove filler words" />
                            <CheckBox x:Name="LowercaseTranscriptionCheckBox" Content="Lowercase transcription" />
                            <CheckBox x:Name="AppendTrailingSpaceCheckBox" Content="Append trailing space" />
                            <ComboBox x:Name="PunctuationCleanupComboBox" Header="Punctuation cleanup" SelectedIndex="0">
                                <ComboBoxItem Content="Keep" />
                                <ComboBoxItem Content="Remove all" />
                                <ComboBoxItem Content="Remove trailing period" />
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Spacing="8">
                            <TextBlock Text="Privacy" FontWeight="SemiBold" />
                            <CheckBox
                                x:Name="TranscriptionCleanupCheckBox"
                                Content="Auto-delete Transcripts"
                                Checked="CleanupSettingCheckBox_Changed"
                                Unchecked="CleanupSettingCheckBox_Changed" />
                            <ComboBox
                                x:Name="TranscriptionRetentionComboBox"
                                Header="Delete After"
                                SelectedIndex="2">
                                <ComboBoxItem Content="Immediately" />
                                <ComboBoxItem Content="1 hour" />
                                <ComboBoxItem Content="1 day" />
                                <ComboBoxItem Content="3 days" />
                                <ComboBoxItem Content="7 days" />
                            </ComboBox>
                            <Button
                                x:Name="RunTranscriptCleanupButton"
                                Content="Run Transcript Cleanup Now"
                                Click="RunTranscriptCleanupButton_Click" />
                            <StackPanel x:Name="AudioCleanupSettingsPanel" Spacing="8">
                                <CheckBox
                                    x:Name="AudioCleanupCheckBox"
                                    Content="Auto-delete Audio Files"
                                    Checked="CleanupSettingCheckBox_Changed"
                                    Unchecked="CleanupSettingCheckBox_Changed" />
                                <ComboBox
                                    x:Name="AudioRetentionComboBox"
                                    Header="Keep Audio For"
                                    SelectedIndex="2">
                                    <ComboBoxItem Content="1 day" />
                                    <ComboBoxItem Content="3 days" />
                                    <ComboBoxItem Content="7 days" />
                                    <ComboBoxItem Content="14 days" />
                                    <ComboBoxItem Content="30 days" />
                                </ComboBox>
                                <Button
                                    x:Name="RunAudioCleanupButton"
                                    Content="Run Audio Cleanup Now"
                                    Click="RunAudioCleanupButton_Click" />
                            </StackPanel>
                            <Button
                                x:Name="ApplyCleanupSettingsButton"
                                Content="Apply Cleanup Settings"
                                Click="ApplyCleanupSettingsButton_Click" />
                        </StackPanel>

                        <StackPanel Spacing="8">
                            <TextBlock Text="General" FontWeight="SemiBold" />
                            <CheckBox
                                x:Name="LaunchAtLoginCheckBox"
                                Content="Launch at Login"
                                Checked="LaunchAtLoginCheckBox_Changed"
                                Unchecked="LaunchAtLoginCheckBox_Changed" />
                            <Button
                                x:Name="RepairLaunchAtLoginButton"
                                Content="Reapply Launch at Login"
                                Click="RepairLaunchAtLoginButton_Click" />
                            <Button
                                x:Name="ResetOnboardingButton"
                                Content="Reset Onboarding"
                                Click="ResetOnboardingButton_Click" />
                        </StackPanel>

                        <StackPanel Spacing="8">
                            <TextBlock Text="Backup" FontWeight="SemiBold" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button
                                    x:Name="ExportSettingsBackupButton"
                                    Content="Export Settings"
                                    Click="ExportSettingsBackupButton_Click" />
                                <Button
                                    x:Name="ImportSettingsBackupButton"
                                    Content="Import Settings"
                                    Click="ImportSettingsBackupButton_Click" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel x:Name="AboutSectionPanel" Spacing="12" Visibility="Collapsed">
                        <TextBlock Text="About / Open Source" FontSize="24" FontWeight="SemiBold" />
                        <TextBlock x:Name="AboutVersionTextBlock" TextWrapping="Wrap" />
                        <TextBlock Text="GPL-3.0 open-source Windows fork" TextWrapping="Wrap" />
                        <TextBox
                            x:Name="RuntimePathTextBox"
                            Header="Runtime path"
                            IsReadOnly="True"
                            TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button
                                x:Name="OpenDiagnosticsFolderButton"
                                Content="Open Diagnostics Folder"
                                Click="OpenDiagnosticsFolderButton_Click" />
                            <Button
                                x:Name="CopyDiagnosticsSummaryButton"
                                Content="Copy Diagnostics Summary"
                                Click="CopyDiagnosticsSummaryButton_Click" />
                            <Button
                                x:Name="ExportDiagnosticLogsButton"
                                Content="Export Diagnostic Logs"
                                Click="ExportDiagnosticLogsButton_Click" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </ScrollViewer>

            <TextBlock
                x:Name="StatusTextBlock"
                Grid.Row="1"
                Text="Idle"
                TextWrapping="Wrap" />
        </Grid>
    </NavigationView>
</Window>
