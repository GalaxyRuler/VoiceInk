<Window
    x:Class="VoiceInk.Windows.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="VoiceInk for Windows">

    <ScrollViewer>
        <Grid Padding="24" RowSpacing="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock
                Grid.Row="0"
                Text="VoiceInk for Windows"
                FontSize="24"
                FontWeight="SemiBold" />

            <TextBox
                x:Name="ModelPathTextBox"
                Grid.Row="1"
                Header="Local whisper model path"
                PlaceholderText="C:\Models\ggml-base.en.bin"
                TextChanged="ModelPathTextBox_TextChanged" />

            <StackPanel Grid.Row="2" Spacing="8">
                <TextBlock Text="Audio Input" FontWeight="SemiBold" />
                <ComboBox
                    x:Name="AudioInputComboBox"
                    Header="Microphone"
                    PlaceholderText="System Default" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button
                        x:Name="RefreshAudioInputsButton"
                        Content="Refresh"
                        Click="RefreshAudioInputsButton_Click" />
                    <Button
                        x:Name="ApplyAudioInputButton"
                        Content="Apply Audio Input"
                        Click="ApplyAudioInputButton_Click" />
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Row="3" Spacing="8">
                <TextBlock Text="Shortcuts" FontWeight="SemiBold" />
                <TextBox
                    x:Name="RecordingHotkeyTextBox"
                    Header="Primary Shortcut"
                    PlaceholderText="Ctrl+Alt+Space" />
                <TextBox
                    x:Name="PasteLastHotkeyTextBox"
                    Header="Paste Last Transcription"
                    PlaceholderText="Ctrl+Alt+V" />
                <TextBox
                    x:Name="PasteLastEnhancedHotkeyTextBox"
                    Header="Paste Last Enhanced Transcription"
                    PlaceholderText="Ctrl+Alt+E" />
                <Button
                    x:Name="ApplyShortcutsButton"
                    Content="Apply Shortcuts"
                    Click="ApplyShortcutsButton_Click" />
            </StackPanel>

            <StackPanel Grid.Row="4" Spacing="8">
                <TextBlock Text="Cleanup" FontWeight="SemiBold" />
                <CheckBox x:Name="RemoveFillerWordsCheckBox" Content="Remove filler words" />
                <CheckBox x:Name="LowercaseTranscriptionCheckBox" Content="Lowercase transcription" />
                <CheckBox x:Name="AppendTrailingSpaceCheckBox" Content="Append trailing space" />
                <ComboBox x:Name="PunctuationCleanupComboBox" Header="Punctuation cleanup" SelectedIndex="0">
                    <ComboBoxItem Content="Keep" />
                    <ComboBoxItem Content="Remove all" />
                    <ComboBoxItem Content="Remove trailing period" />
                </ComboBox>
            </StackPanel>

            <StackPanel Grid.Row="5" Spacing="12">
                <TextBlock Text="Dictionary" FontWeight="SemiBold" />

                <StackPanel Spacing="8">
                    <TextBlock Text="Vocabulary" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox
                            x:Name="VocabularyInputTextBox"
                            Grid.Column="0"
                            PlaceholderText="Add word to vocabulary" />
                        <Button
                            x:Name="AddVocabularyButton"
                            Grid.Column="1"
                            Content="Add"
                            Click="AddVocabularyButton_Click" />
                        <Button
                            x:Name="RemoveVocabularyButton"
                            Grid.Column="2"
                            Content="Remove"
                            Click="RemoveVocabularyButton_Click" />
                    </Grid>
                    <ListView
                        x:Name="VocabularyListView"
                        Height="120"
                        SelectionMode="Single" />
                </StackPanel>

                <StackPanel Spacing="8">
                    <TextBlock Text="Word Replacements" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox
                            x:Name="ReplacementOriginalTextBox"
                            Grid.Column="0"
                            Header="Original text"
                            PlaceholderText="Voice ink, Voicing" />
                        <TextBox
                            x:Name="ReplacementTextBox"
                            Grid.Column="1"
                            Header="Replacement text"
                            PlaceholderText="VoiceInk" />
                        <Button
                            x:Name="AddReplacementButton"
                            Grid.Column="2"
                            Content="Add"
                            Click="AddReplacementButton_Click" />
                        <Button
                            x:Name="RemoveReplacementButton"
                            Grid.Column="3"
                            Content="Remove"
                            Click="RemoveReplacementButton_Click" />
                    </Grid>
                    <ListView
                        x:Name="ReplacementListView"
                        Height="140"
                        SelectionMode="Single" />
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Row="6" Spacing="12">
                <TextBlock Text="History" FontWeight="SemiBold" />
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox
                        x:Name="HistorySearchTextBox"
                        Grid.Column="0"
                        PlaceholderText="Search transcriptions..." />
                    <Button x:Name="SearchHistoryButton" Grid.Column="1" Content="Search" Click="SearchHistoryButton_Click" />
                    <Button x:Name="ClearHistorySearchButton" Grid.Column="2" Content="Clear" Click="ClearHistorySearchButton_Click" />
                    <Button x:Name="RefreshHistoryButton" Grid.Column="3" Content="Refresh" Click="RefreshHistoryButton_Click" />
                    <Button x:Name="ExportHistoryButton" Grid.Column="4" Content="Export CSV" Click="ExportHistoryButton_Click" />
                    <Button x:Name="PasteLastButton" Grid.Column="5" Content="Paste Last" Click="PasteLastButton_Click" />
                    <Button x:Name="PasteLastEnhancedButton" Grid.Column="6" Content="Paste Last Enhanced" Click="PasteLastEnhancedButton_Click" />
                </Grid>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="DeleteHistoryButton" Content="Delete" Click="DeleteHistoryButton_Click" />
                </StackPanel>
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="3*" />
                    </Grid.ColumnDefinitions>
                    <ListView
                        x:Name="HistoryListView"
                        Grid.Column="0"
                        Height="220"
                        SelectionChanged="HistoryListView_SelectionChanged"
                        SelectionMode="Single" />
                    <StackPanel Grid.Column="1" Spacing="8">
                        <TextBlock x:Name="HistoryMetadataTextBlock" Text="Select a transcription" TextWrapping="Wrap" />
                        <TextBox
                            x:Name="HistoryOriginalTextBox"
                            Header="Original"
                            AcceptsReturn="True"
                            Height="80"
                            IsReadOnly="True"
                            TextWrapping="Wrap" />
                        <TextBox
                            x:Name="HistoryFinalTextBox"
                            Header="Final"
                            AcceptsReturn="True"
                            Height="80"
                            IsReadOnly="True"
                            TextWrapping="Wrap" />
                        <TextBox
                            x:Name="HistoryEnhancedTextBox"
                            Header="Enhanced"
                            AcceptsReturn="True"
                            Height="80"
                            IsReadOnly="True"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </StackPanel>

            <StackPanel Grid.Row="7" Orientation="Horizontal" Spacing="8">
                <Button x:Name="StartButton" Content="Start Recording" Click="StartButton_Click" />
                <Button x:Name="StopButton" Content="Stop And Insert" Click="StopButton_Click" IsEnabled="False" />
            </StackPanel>

            <TextBlock
                x:Name="StatusTextBlock"
                Grid.Row="8"
                Text="Idle"
                TextWrapping="Wrap" />
        </Grid>
    </ScrollViewer>
</Window>
