<Window
    x:Class="VoiceInk.Windows.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:VoiceInk.Windows.App"
    Title="VoiceInk for Windows">

    <NavigationView
        x:Name="RootNavigationView"
        IsBackButtonVisible="Collapsed"
        IsSettingsVisible="False"
        PaneTitle="VoiceInk"
        SelectionChanged="RootNavigationView_SelectionChanged">
        <NavigationView.Resources>
            <local:WaveformPeakHeightConverter x:Key="WaveformPeakHeightConverter" />
        </NavigationView.Resources>
        <Grid RowSpacing="12" Padding="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ScrollViewer Grid.Row="0">
                <Grid>
                    <StackPanel x:Name="DashboardSectionPanel" Spacing="16">
                        <TextBlock Text="Dashboard" FontSize="24" FontWeight="SemiBold" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="StartButton" Content="Start Recording" Click="StartButton_Click" />
                            <Button x:Name="StopButton" Content="Stop And Insert" Click="StopButton_Click" IsEnabled="False" />
                            <Button x:Name="CancelButton" Content="Cancel Recording" Click="CancelButton_Click" IsEnabled="False" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel
                        x:Name="TranscribeAudioSectionPanel"
                        AllowDrop="True"
                        DragOver="TranscribeAudioSectionPanel_DragOver"
                        Drop="TranscribeAudioSectionPanel_Drop"
                        Spacing="12"
                        Visibility="Collapsed">
                        <TextBlock Text="Transcribe Audio" FontSize="24" FontWeight="SemiBold" />
                        <TextBlock
                            Text="Choose audio or video files, then process them sequentially with the current transcription provider and cleanup settings."
                            TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button
                                x:Name="ChooseAudioFilesButton"
                                Content="Choose Files"
                                Click="ChooseAudioFilesButton_Click" />
                            <Button
                                x:Name="StartAudioFileQueueButton"
                                Content="Start"
                                Click="StartAudioFileQueueButton_Click" />
                            <Button
                                x:Name="CancelAudioFileQueueButton"
                                Content="Cancel"
                                Click="CancelAudioFileQueueButton_Click" />
                            <Button
                                x:Name="ClearAudioFileQueueButton"
                                Content="Clear"
                                Click="ClearAudioFileQueueButton_Click" />
                            <Button
                                x:Name="RemoveAudioFileQueueItemButton"
                                Content="Remove"
                                Click="RemoveAudioFileQueueItemButton_Click" />
                            <Button
                                x:Name="RetryAudioFileQueueItemButton"
                                Content="Retry"
                                Click="RetryAudioFileQueueItemButton_Click" />
                        </StackPanel>
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="3*" />
                            </Grid.ColumnDefinitions>
                            <ListView
                                x:Name="AudioFileQueueListView"
                                Grid.Column="0"
                                Height="260"
                                SelectionChanged="AudioFileQueueListView_SelectionChanged"
                                SelectionMode="Single" />
                            <StackPanel Grid.Column="1" Spacing="8">
                                <TextBlock
                                    x:Name="AudioFileQueueMetadataTextBlock"
                                    Text="No files queued"
                                    TextWrapping="Wrap" />
                                <TextBox
                                    x:Name="AudioFileQueueTranscriptTextBox"
                                    Header="Transcript"
                                    AcceptsReturn="True"
                                    Height="180"
                                    IsReadOnly="True"
                                    TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button
                                        x:Name="CopyAudioFileQueueTextButton"
                                        Content="Copy"
                                        Click="CopyAudioFileQueueTextButton_Click" />
                                    <Button
                                        x:Name="SaveAudioFileQueueTextButton"
                                        Content="Save"
                                        Click="SaveAudioFileQueueTextButton_Click" />
                                    <Button
                                        x:Name="EnhanceAudioFileQueueTextButton"
                                        Content="Enhance"
                                        Click="EnhanceAudioFileQueueTextButton_Click" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                        <TextBlock
                            Text="Supported formats depend on Windows Media Foundation codecs. WAV, MP3, M4A, MP4, MOV, AAC, WMA, WMV, AVI, 3GP, 3G2, and FLAC are accepted by the picker."
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel x:Name="ModelsSectionPanel" Spacing="12" Visibility="Collapsed">
                        <TextBlock Text="AI Models" FontSize="24" FontWeight="SemiBold" />
                        <TextBlock
                            x:Name="DefaultModelStatusTextBlock"
                            FontWeight="SemiBold"
                            Text="Default Model: No model selected"
                            TextWrapping="Wrap" />
                        <TextBlock
                            x:Name="ModelRepairHintTextBlock"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap" />
                        <StackPanel Spacing="4">
                            <TextBlock
                                x:Name="ModelLibraryTitleTextBlock"
                                FontWeight="SemiBold"
                                Text="Local Whisper Library" />
                            <TextBlock
                                x:Name="ModelLibrarySummaryTextBlock"
                                TextWrapping="Wrap" />
                            <TextBlock
                                x:Name="ModelLibraryDefaultTextBlock"
                                TextWrapping="Wrap" />
                            <TextBlock
                                x:Name="ModelLibraryCleanupHintTextBlock"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <ListView
                            x:Name="LocalModelCatalogListView"
                            Height="330"
                            SelectionChanged="LocalModelCatalogListView_SelectionChanged"
                            SelectionMode="Single">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        BorderBrush="Gray"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Margin="0,0,0,8"
                                        Padding="12">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Spacing="6">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock
                                                        Text="{Binding DisplayName}"
                                                        FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding Status}" />
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Spacing="12">
                                                    <TextBlock Text="{Binding LanguageDisplay}" />
                                                    <TextBlock Text="{Binding Size}" />
                                                    <TextBlock Text="Speed" />
                                                    <TextBlock Text="{Binding SpeedScore}" />
                                                    <TextBlock Text="Accuracy" />
                                                    <TextBlock Text="{Binding AccuracyScore}" />
                                                </StackPanel>
                                                <TextBlock
                                                    Text="{Binding Description}"
                                                    TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button
                                x:Name="DownloadCatalogModelButton"
                                Content="Download"
                                Click="DownloadCatalogModelButton_Click" />
                            <Button
                                x:Name="UseCatalogModelButton"
                                Content="Set as Default"
                                Click="UseCatalogModelButton_Click" />
                            <Button
                                x:Name="ShowCatalogModelButton"
                                Content="Show in Explorer"
                                Click="ShowCatalogModelButton_Click" />
                            <Button
                                x:Name="CancelModelDownloadButton"
                                Content="Cancel Download"
                                Click="CancelModelDownloadButton_Click" />
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <ProgressBar
                                x:Name="ModelDownloadProgressBar"
                                Minimum="0"
                                Maximum="100"
                                Visibility="Collapsed" />
                            <TextBlock
                                x:Name="ModelDownloadStatusTextBlock"
                                TextWrapping="Wrap" />
                            <TextBlock
                                x:Name="ModelWarmupStatusTextBlock"
                                Text="Model warmup idle"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Spacing="8">
                            <CheckBox
                                x:Name="PrewarmModelOnWakeCheckBox"
                                Content="Prewarm Local Model"
                                Checked="PrewarmModelOnWakeCheckBox_Changed"
                                Unchecked="PrewarmModelOnWakeCheckBox_Changed" />
                            <CheckBox
                                x:Name="ShowLiveTranscriptPreviewCheckBox"
                                Content="Show Live Transcript Preview"
                                Checked="ShowLiveTranscriptPreviewCheckBox_Changed"
                                Unchecked="ShowLiveTranscriptPreviewCheckBox_Changed" />
                            <Button
                                x:Name="WarmupSelectedModelButton"
                                HorizontalAlignment="Left"
                                Content="Warm Up Selected Model"
                                Click="WarmupSelectedModelButton_Click" />
                        </StackPanel>
                        <ComboBox
                            x:Name="LanguageComboBox"
                            DisplayMemberPath="DisplayName"
                            Header="Transcription Language"
                            SelectionChanged="LanguageComboBox_SelectionChanged" />
                        <TextBlock
                            x:Name="LanguageDescriptionTextBlock"
                            TextWrapping="Wrap" />
                        <TextBox
                            x:Name="ModelPathTextBox"
                            Header="Local whisper model path"
                            PlaceholderText="C:\Models\ggml-base.en.bin"
                            TextChanged="ModelPathTextBox_TextChanged" />
                        <ComboBox
                            x:Name="ModelComboBox"
                            Header="Imported Local Models"
                            PlaceholderText="No local models imported"
                            SelectionChanged="ModelComboBox_SelectionChanged" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button
                                x:Name="ImportModelButton"
                                Content="Import Model"
                                Click="ImportModelButton_Click" />
                            <Button
                                x:Name="UseSelectedModelButton"
                                Content="Use Selected Model"
                                Click="UseSelectedModelButton_Click" />
                            <Button
                                x:Name="RemoveUnavailableModelsButton"
                                Content="Remove Unavailable Models"
                                Click="RemoveUnavailableModelsButton_Click" />
                            <Button
                                x:Name="OpenModelDownloadsButton"
                                Content="Open GGML Model Downloads"
                                Click="OpenModelDownloadsButton_Click" />
                        </StackPanel>
                        <ComboBox
                            x:Name="TranscriptionProviderComboBox"
                            Header="Transcription Provider"
                            SelectionChanged="TranscriptionProviderComboBox_SelectionChanged">
                            <ComboBoxItem Content="Local Whisper" />
                            <ComboBoxItem Content="OpenAI-compatible" />
                        </ComboBox>
                        <ComboBox
                            x:Name="CloudTranscriptionPresetComboBox"
                            DisplayMemberPath="DisplayName"
                            Header="Cloud provider preset"
                            SelectionChanged="CloudTranscriptionPresetComboBox_SelectionChanged" />
                        <Border
                            BorderBrush="Gray"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12">
                            <StackPanel Spacing="8">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock
                                        Text="{Binding SelectedItem.DisplayName, ElementName=CloudTranscriptionPresetComboBox}"
                                        FontWeight="SemiBold" />
                                    <TextBlock
                                        Text="{Binding SelectedItem.StreamingDisplay, ElementName=CloudTranscriptionPresetComboBox}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <TextBlock Text="{Binding SelectedItem.LanguageDisplay, ElementName=CloudTranscriptionPresetComboBox}" />
                                    <TextBlock Text="Speed" />
                                    <TextBlock Text="{Binding SelectedItem.SpeedDisplay, ElementName=CloudTranscriptionPresetComboBox}" />
                                    <TextBlock Text="Accuracy" />
                                    <TextBlock Text="{Binding SelectedItem.AccuracyDisplay, ElementName=CloudTranscriptionPresetComboBox}" />
                                </StackPanel>
                                <TextBlock
                                    Text="{Binding SelectedItem.Description, ElementName=CloudTranscriptionPresetComboBox}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBox
                                x:Name="CloudTranscriptionEndpointTextBox"
                                Grid.Column="0"
                                Header="Cloud transcription endpoint"
                                PlaceholderText="https://api.example.com/v1/audio/transcriptions" />
                            <TextBox
                                x:Name="CloudTranscriptionModelTextBox"
                                Grid.Column="1"
                                Header="Cloud transcription model"
                                PlaceholderText="gpt-4o-transcribe" />
                        </Grid>
                        <ComboBox
                            x:Name="CloudTranscriptionModelComboBox"
                            Header="Preset model"
                            SelectionChanged="CloudTranscriptionModelComboBox_SelectionChanged" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <PasswordBox
                                x:Name="CloudTranscriptionApiKeyPasswordBox"
                                Grid.Column="0"
                                Header="Cloud transcription API key" />
                            <Button
                                x:Name="SaveCloudTranscriptionKeyButton"
                                Grid.Column="1"
                                Content="Save Key"
                                Click="SaveCloudTranscriptionKeyButton_Click" />
                            <Button
                                x:Name="ClearCloudTranscriptionKeyButton"
                                Grid.Column="2"
                                Content="Clear Key"
                                Click="ClearCloudTranscriptionKeyButton_Click" />
                        </Grid>
                        <TextBlock
                            x:Name="CloudTranscriptionKeyStatusTextBlock"
                            Text="Cloud transcription API key not checked"
                            TextWrapping="Wrap" />
                        <Button
                            x:Name="ApplyTranscriptionProviderSettingsButton"
                            Content="Apply Transcription Provider Settings"
                            Click="ApplyTranscriptionProviderSettingsButton_Click" />
                        <Button
                            x:Name="TestCloudTranscriptionProviderButton"
                            Content="Test Provider"
                            Click="TestCloudTranscriptionProviderButton_Click" />
                    </StackPanel>

                    <StackPanel x:Name="EnhancementSectionPanel" Spacing="12" Visibility="Collapsed">
                        <TextBlock Text="Enhancement" FontSize="24" FontWeight="SemiBold" />
                        <CheckBox
                            x:Name="EnhancementEnabledCheckBox"
                            Content="Enable Enhancement" />
                        <CheckBox
                            x:Name="UseClipboardContextCheckBox"
                            Content="Clipboard Context" />
                        <CheckBox
                            x:Name="UseOcrContextCheckBox"
                            Content="Screen OCR Context"
                            Click="OcrContextControl_Click" />
                        <CheckBox
                            x:Name="UseOcrCaptureRegionCheckBox"
                            Content="Constrain OCR Region"
                            Click="OcrContextControl_Click" />
                        <Button
                            x:Name="PickOcrRegionButton"
                            Content="Select Region"
                            Click="PickOcrRegionButton_Click" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <NumberBox
                                x:Name="OcrRegionLeftNumberBox"
                                Grid.Column="0"
                                Header="Left"
                                Minimum="-100000"
                                SmallChange="10" />
                            <NumberBox
                                x:Name="OcrRegionTopNumberBox"
                                Grid.Column="1"
                                Header="Top"
                                Minimum="-100000"
                                SmallChange="10" />
                            <NumberBox
                                x:Name="OcrRegionWidthNumberBox"
                                Grid.Column="2"
                                Header="Width"
                                Minimum="0"
                                SmallChange="10" />
                            <NumberBox
                                x:Name="OcrRegionHeightNumberBox"
                                Grid.Column="3"
                                Header="Height"
                                Minimum="0"
                                SmallChange="10" />
                        </Grid>
                        <ComboBox
                            x:Name="EnhancementProviderPresetComboBox"
                            DisplayMemberPath="DisplayName"
                            Header="AI provider"
                            SelectionChanged="EnhancementProviderPresetComboBox_SelectionChanged" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBox
                                x:Name="EnhancementEndpointTextBox"
                                Grid.Column="0"
                                Header="OpenAI-compatible endpoint"
                                PlaceholderText="https://api.example.com/v1/chat/completions" />
                            <TextBox
                                x:Name="EnhancementModelTextBox"
                                Grid.Column="1"
                                Header="Model"
                                PlaceholderText="model-name" />
                        </Grid>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox
                                x:Name="EnhancementModelComboBox"
                                Grid.Column="0"
                                Header="Preset model"
                                SelectionChanged="EnhancementModelComboBox_SelectionChanged" />
                            <Button
                                x:Name="RefreshEnhancementModelsButton"
                                Grid.Column="1"
                                Margin="0,28,0,0"
                                Content="Refresh Models"
                                Click="RefreshEnhancementModelsButton_Click" />
                        </Grid>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <PasswordBox
                                x:Name="EnhancementApiKeyPasswordBox"
                                Grid.Column="0"
                                Header="API key" />
                            <Button
                                x:Name="SaveEnhancementKeyButton"
                                Grid.Column="1"
                                Content="Save Key"
                                Click="SaveEnhancementKeyButton_Click" />
                            <Button
                                x:Name="ClearEnhancementKeyButton"
                                Grid.Column="2"
                                Content="Clear Key"
                                Click="ClearEnhancementKeyButton_Click" />
                        </Grid>
                        <TextBlock
                            x:Name="EnhancementKeyStatusTextBlock"
                            Text="API key not checked"
                            TextWrapping="Wrap" />
                        <ComboBox
                            x:Name="EnhancementPromptComboBox"
                            Header="Prompt"
                            SelectionChanged="EnhancementPromptComboBox_SelectionChanged" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBox
                                x:Name="PromptTitleTextBox"
                                Grid.Column="0"
                                Header="Prompt title"
                                PlaceholderText="Prompt name" />
                            <TextBox
                                x:Name="PromptTriggerWordsTextBox"
                                Grid.Column="1"
                                Header="Trigger words"
                                PlaceholderText="chat mode, email mode" />
                        </Grid>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBox
                                x:Name="PromptIconTextBox"
                                Grid.Column="0"
                                Header="Prompt icon"
                                PlaceholderText="doc.text.fill" />
                            <TextBox
                                x:Name="PromptDescriptionTextBox"
                                Grid.Column="1"
                                Header="Prompt description"
                                PlaceholderText="Short description" />
                        </Grid>
                        <TextBox
                            x:Name="PromptInstructionsTextBox"
                            Header="Prompt instructions"
                            AcceptsReturn="True"
                            Height="140"
                            TextWrapping="Wrap"
                            PlaceholderText="Enter custom prompt instructions" />
                        <CheckBox
                            x:Name="PromptUseSystemInstructionsCheckBox"
                            Content="Use transcription enhancement instructions" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button
                                x:Name="NewPromptButton"
                                Content="New Prompt"
                                Click="NewPromptButton_Click" />
                            <Button
                                x:Name="SavePromptButton"
                                Content="Save Prompt"
                                Click="SavePromptButton_Click" />
                            <Button
                                x:Name="DeletePromptButton"
                                Content="Delete Prompt"
                                Click="DeletePromptButton_Click" />
                        </StackPanel>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBox
                                x:Name="EnhancementTimeoutTextBox"
                                Grid.Column="0"
                                Header="Timeout seconds"
                                PlaceholderText="7" />
                            <TextBox
                                x:Name="ShortEnhancementThresholdTextBox"
                                Grid.Column="1"
                                Header="Short enhancement threshold"
                                PlaceholderText="3" />
                        </Grid>
                        <StackPanel Spacing="8">
                            <CheckBox
                                x:Name="SkipShortEnhancementCheckBox"
                                Content="Skip enhancement for short phrases" />
                            <CheckBox
                                x:Name="EnhancementRetryOnTimeoutCheckBox"
                                Content="Retry on timeout" />
                        </StackPanel>
                        <Button
                            x:Name="ApplyEnhancementSettingsButton"
                            Content="Apply Enhancement Settings"
                            Click="ApplyEnhancementSettingsButton_Click" />
                    </StackPanel>

                    <StackPanel x:Name="PowerModeSectionPanel" Spacing="12" Visibility="Collapsed">
                        <TextBlock x:Name="PowerModeTitleTextBlock" Text="Power Mode" FontSize="24" FontWeight="SemiBold" />
                        <TextBlock
                            x:Name="PowerModeDescriptionTextBlock"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            x:Name="PowerModeCountTextBlock"
                            FontWeight="SemiBold"
                            TextWrapping="Wrap" />
                        <TextBlock
                            x:Name="PowerModeEmptyTextBlock"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap"
                            Visibility="Collapsed" />
                        <TextBlock
                            x:Name="PowerModeActiveWindowTextBlock"
                            Text="Active window not checked"
                            TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button
                                x:Name="RefreshPowerModeTargetButton"
                                Content="Refresh Active Window"
                                Click="RefreshPowerModeTargetButton_Click" />
                            <Button
                                x:Name="UsePowerModeTargetButton"
                                Content="Use Active Window"
                                Click="UsePowerModeTargetButton_Click" />
                        </StackPanel>
                        <InfoBar
                            x:Name="PowerModeValidationInfoBar"
                            IsClosable="False"
                            IsOpen="False" />

                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="3*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="8">
                                <ListView
                                    x:Name="PowerModeRulesListView"
                                    Height="260"
                                    SelectionChanged="PowerModeRulesListView_SelectionChanged"
                                    SelectionMode="Single" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button
                                        x:Name="MovePowerModeRuleUpButton"
                                        Content="Move Up"
                                        Click="MovePowerModeRuleUpButton_Click" />
                                    <Button
                                        x:Name="MovePowerModeRuleDownButton"
                                        Content="Move Down"
                                        Click="MovePowerModeRuleDownButton_Click" />
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="8">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox
                                        x:Name="PowerModeNameTextBox"
                                        Grid.Column="0"
                                        Header="Name"
                                        PlaceholderText="Chat" />
                                    <TextBox
                                        x:Name="PowerModeEmojiTextBox"
                                        Grid.Column="1"
                                        Header="Emoji"
                                        PlaceholderText="C" />
                                </Grid>
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox
                                        x:Name="PowerModeProcessTextBox"
                                        Grid.Column="0"
                                        Header="Process contains"
                                        PlaceholderText="teams" />
                                    <TextBox
                                        x:Name="PowerModeWindowTitleTextBox"
                                        Grid.Column="1"
                                        Header="Window title contains"
                                        PlaceholderText="chat" />
                                </Grid>
                                <TextBox
                                    x:Name="PowerModeBrowserUrlTextBox"
                                    Header="Browser URL contains"
                                    PlaceholderText="example.com/docs" />
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <CheckBox
                                        x:Name="PowerModeEnabledCheckBox"
                                        Content="Enabled"
                                        IsChecked="True" />
                                    <CheckBox
                                        x:Name="PowerModeDefaultCheckBox"
                                        Content="Default" />
                                </StackPanel>
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox
                                        x:Name="PowerModeModelPathTextBox"
                                        Grid.Column="0"
                                        Header="Model override"
                                        PlaceholderText="C:\Models\ggml-base.en.bin" />
                                    <TextBox
                                        x:Name="PowerModeLanguageTextBox"
                                        Grid.Column="1"
                                        Header="Language override"
                                        PlaceholderText="en" />
                                </Grid>
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox
                                        x:Name="PowerModeEnhancementOverrideComboBox"
                                        Grid.Column="0"
                                        Header="Enhancement override"
                                        SelectedIndex="0">
                                        <ComboBoxItem Content="Keep base" />
                                        <ComboBoxItem Content="Enable" />
                                        <ComboBoxItem Content="Disable" />
                                    </ComboBox>
                                    <ComboBox
                                        x:Name="PowerModePromptOverrideComboBox"
                                        Grid.Column="1"
                                        Header="Prompt override" />
                                </Grid>
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox
                                        x:Name="PowerModeAppendTrailingSpaceCheckBox"
                                        Grid.Column="0"
                                        Content="Trailing space"
                                        IsThreeState="True" />
                                    <CheckBox
                                        x:Name="PowerModeRemoveFillerWordsCheckBox"
                                        Grid.Column="1"
                                        Content="Remove fillers"
                                        IsThreeState="True" />
                                    <CheckBox
                                        x:Name="PowerModeLowercaseCheckBox"
                                        Grid.Column="2"
