<Window
    x:Class="VoiceInk.Windows.App.FloatingRecorderWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="VoiceInk Recorder">

    <Grid Background="Transparent" Padding="0" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border
            x:Name="PromptPopoverPanel"
            Width="220"
            MaxHeight="232"
            Padding="12"
            Margin="10,0,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Bottom"
            Background="#111111"
            BorderBrush="#333333"
            BorderThickness="1"
            CornerRadius="8"
            PointerEntered="PromptPopoverPanel_PointerEntered"
            PointerExited="PromptPopoverPanel_PointerExited"
            Visibility="Collapsed">
            <StackPanel Spacing="8">
                <CheckBox
                    x:Name="PromptEnhancementCheckBox"
                    AutomationProperties.Name="AI Enhancement"
                    Checked="PromptEnhancementCheckBox_Changed"
                    Content="AI Enhancement"
                    Foreground="White"
                    Unchecked="PromptEnhancementCheckBox_Changed" />

                <Border Height="1" Background="#2A2A2A" />

                <ScrollViewer MaxHeight="168" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="PromptChoicesStackPanel" Spacing="4" />
                </ScrollViewer>
            </StackPanel>
        </Border>

        <Border
            x:Name="PowerModePopoverPanel"
            Width="220"
            MaxHeight="232"
            Padding="12"
            Margin="0,0,10,0"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Background="#111111"
            BorderBrush="#333333"
            BorderThickness="1"
            CornerRadius="8"
            PointerEntered="PowerModePopoverPanel_PointerEntered"
            PointerExited="PowerModePopoverPanel_PointerExited"
            Visibility="Collapsed">
            <StackPanel Spacing="8">
                <TextBlock
                    x:Name="PowerModePopoverHeaderTextBlock"
                    Foreground="White"
                    FontSize="14"
                    FontWeight="SemiBold"
                    Text="Select Power Mode"
                    TextTrimming="CharacterEllipsis" />

                <Border Height="1" Background="#2A2A2A" />

                <ScrollViewer MaxHeight="168" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="PowerModeChoicesStackPanel" Spacing="4" />
                </ScrollViewer>
            </StackPanel>
        </Border>

        <Border
            x:Name="RecorderChrome"
            Grid.Row="1"
            Width="384"
            Height="104"
            Padding="14"
            Background="#111111"
            BorderBrush="#333333"
            BorderThickness="1"
            CornerRadius="18">
            <Grid RowSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button
                        x:Name="PromptButton"
                        Grid.Column="0"
                        AutomationProperties.Name="Recorder prompt"
                        Click="PromptButton_Click"
                        IsEnabled="False"
                        MaxWidth="92"
                        PointerEntered="PromptButton_PointerEntered"
                        PointerExited="PromptButton_PointerExited"
                        ToolTipService.ToolTip="Prompt">
                        <TextBlock
                            x:Name="PromptButtonTextBlock"
                            Text="Prompt"
                            TextTrimming="CharacterEllipsis" />
                    </Button>

                    <StackPanel Grid.Column="1" Spacing="2" HorizontalAlignment="Center">
                        <TextBlock
                            x:Name="TitleTextBlock"
                            Foreground="White"
                            FontSize="16"
                            FontWeight="SemiBold"
                            Text="Recording"
                            TextAlignment="Center" />
                        <TextBlock
                            x:Name="DetailTextBlock"
                            Foreground="#BEBEBE"
                            FontSize="12"
                            Text="Listening"
                            TextAlignment="Center" />
                    </StackPanel>

                    <Button
                        x:Name="PowerModeButton"
                        Grid.Column="2"
                        AutomationProperties.Name="Recorder Power Mode"
                        Click="PowerModeButton_Click"
                        IsEnabled="False"
                        MaxWidth="92"
                        PointerEntered="PowerModeButton_PointerEntered"
                        PointerExited="PowerModeButton_PointerExited"
                        ToolTipService.ToolTip="Power Mode">
                        <TextBlock
                            x:Name="PowerModeButtonTextBlock"
                            Text="Auto"
                            TextTrimming="CharacterEllipsis" />
                    </Button>
                </Grid>

                <Grid Grid.Row="1" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                        <Border x:Name="PulseBar1" Width="8" Height="12" CornerRadius="4" Background="#4CC2FF" />
                        <Border x:Name="PulseBar2" Width="8" Height="16" CornerRadius="4" Background="#7CDB8A" />
                        <Border x:Name="PulseBar3" Width="8" Height="20" CornerRadius="4" Background="#FFD166" />
                        <Border x:Name="PulseBar4" Width="8" Height="16" CornerRadius="4" Background="#FF7A90" />
                        <Border x:Name="PulseBar5" Width="8" Height="12" CornerRadius="4" Background="#B9A7FF" />
                    </StackPanel>

                    <TextBlock
                        x:Name="ElapsedTextBlock"
                        Grid.Column="1"
                        Foreground="White"
                        FontSize="18"
                        FontWeight="SemiBold"
                        Text="00:00"
                        VerticalAlignment="Center" />

                    <Button
                        x:Name="StopRecordingButton"
                        Grid.Column="2"
                        AutomationProperties.Name="Stop and insert recording"
                        Click="StopRecordingButton_Click"
                        IsEnabled="False"
                        ToolTipService.ToolTip="Stop and insert">
                        <SymbolIcon Symbol="Stop" />
                    </Button>

                    <Button
                        x:Name="CancelRecordingButton"
                        Grid.Column="3"
                        AutomationProperties.Name="Cancel recording"
                        Click="CancelRecordingButton_Click"
                        IsEnabled="False"
                        ToolTipService.ToolTip="Cancel recording">
                        <SymbolIcon Symbol="Cancel" />
                    </Button>
                </Grid>

                <TextBlock
                    x:Name="ShortcutHintTextBlock"
                    Grid.Row="2"
                    Foreground="#8E8E8E"
                    FontSize="11"
                    Text="Shortcut, tray, or recorder controls"
                    TextAlignment="Center"
                    TextTrimming="CharacterEllipsis" />
            </Grid>
        </Border>
    </Grid>
</Window>
